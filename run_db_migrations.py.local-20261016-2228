# -*- coding: utf-8 -*-
"""
一键执行后端 db 目录下所有 .sql 迁移脚本到测试数据库。

设计要点：
- 全部使用相对路径：脚本、db 目录、后端配置文件都相对本文件所在目录定位。
- 数据库连接信息自动从后端 application-test.yml 解析（jdbc url / username / password），
  也可用命令行参数覆盖。
- 用 schema_migrations 表记录已执行的文件（文件名 + 内容校验和），
  因此每次部署重复执行本脚本是安全的：已应用且未改动的文件会被跳过。
- 语句级容错：对「列/表/索引已存在」等幂等 DDL 报错按告警跳过，其余报错计入失败。

用法（在本目录下）：
    py run_db_migrations.py                 # 执行全部未应用的 .sql
    py run_db_migrations.py --list          # 只列出将要执行的文件
    py run_db_migrations.py --dry-run       # 解析并打印语句，不真正执行
    py run_db_migrations.py --force         # 忽略记录，全部重新执行
    py run_db_migrations.py --only a.sql    # 只执行指定文件（可重复）
    py run_db_migrations.py --strict        # 遇到任何报错立即中止（默认继续并汇总）
"""
import argparse
import hashlib
import os
import re
import sys
from pathlib import Path

import pymysql

# Windows 控制台默认 GBK，强制切到 UTF-8 以免中文/符号报错
try:
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    sys.stderr.reconfigure(encoding="utf-8", errors="replace")
except Exception:
    pass

# ============ 相对路径（全部基于本文件所在目录）============
BASE_DIR = Path(__file__).resolve().parent
DB_DIR = BASE_DIR / "db"
CONFIG_FILE = BASE_DIR / "kuaima_backend" / "src" / "main" / "resources" / "application-test.yml"

# 幂等 DDL 可安全忽略的 MySQL 错误码：
# 1007 库已存在 1050 表已存在 1060 列重复 1061 索引/键名重复
# 1091 无法删除(不存在) 1304 存储过程/函数已存在 1054 未知列(旧列名已改)
TOLERATED_ERRORS = {1007, 1050, 1060, 1061, 1091, 1304}

TRACK_TABLE = "schema_migrations"


def log(msg):
    print(msg, flush=True)


def parse_datasource(config_path: Path):
    """从 application-dev.yml 解析 jdbc url / username / password。"""
    if not config_path.is_file():
        raise FileNotFoundError(f"找不到配置文件: {config_path}")
    text = config_path.read_text(encoding="utf-8-sig")
    url_m = re.search(r"jdbc:mysql://([^:/\s]+):(\d+)/([^?\s]+)", text)
    if not url_m:
        raise ValueError(f"未能从 {config_path} 解析到 jdbc:mysql 连接串")
    host, port, database = url_m.group(1), int(url_m.group(2)), url_m.group(3)
    user_m = re.search(r"^\s*username:\s*(.+?)\s*$", text, re.MULTILINE)
    pass_m = re.search(r"^\s*password:\s*(.+?)\s*$", text, re.MULTILINE)
    if not user_m or not pass_m:
        raise ValueError(f"未能从 {config_path} 解析到 username/password")
    return {
        "host": host,
        "port": port,
        "database": database,
        "user": user_m.group(1),
        "password": pass_m.group(1),
    }


def split_statements(sql: str):
    """把脚本切成独立语句，正确处理注释、引号与 DELIMITER 指令。"""
    statements = []
    delimiter = ";"
    buf = []
    i, n = 0, len(sql)
    while i < n:
        ch = sql[i]

        # DELIMITER 指令（mysql 客户端命令，需自行处理）
        if ch in ("D", "d") and sql[i:i + 9].upper() == "DELIMITER" and \
                (i == 0 or sql[i - 1] in " \t\r\n"):
            rest = sql[i + 9:]
            line_end = rest.find("\n")
            line = rest if line_end == -1 else rest[:line_end]
            new_delim = line.strip()
            if new_delim:
                if "".join(buf).strip():
                    statements.append("".join(buf).strip())
                    buf = []
                delimiter = new_delim
            i = n if line_end == -1 else i + 9 + line_end + 1
            continue

        # 行注释 --  / #
        if ch == "-" and sql[i:i + 2] == "--" and (i + 2 >= n or sql[i + 2] in " \t\r\n-"):
            j = sql.find("\n", i)
            i = n if j == -1 else j + 1
            continue
        if ch == "#":
            j = sql.find("\n", i)
            i = n if j == -1 else j + 1
            continue
        # 块注释 /* */
        if ch == "/" and sql[i:i + 2] == "/*":
            j = sql.find("*/", i + 2)
            i = n if j == -1 else j + 2
            continue
        # 引号 / 反引号字符串
        if ch in ("'", '"', "`"):
            quote = ch
            buf.append(ch)
            i += 1
            while i < n:
                c = sql[i]
                if c == "\\":  # 反斜杠转义
                    buf.append(c)
                    if i + 1 < n:
                        buf.append(sql[i + 1])
                        i += 2
                        continue
                if c == quote:
                    if i + 1 < n and sql[i + 1] == quote:  # 双写转义
                        buf.append(c)
                        buf.append(sql[i + 1])
                        i += 2
                        continue
                    buf.append(c)
                    i += 1
                    break
                buf.append(c)
                i += 1
            continue
        # 语句结束符
        if sql[i:i + len(delimiter)] == delimiter:
            stmt = "".join(buf).strip()
            if stmt:
                statements.append(stmt)
            buf = []
            i += len(delimiter)
            continue

        buf.append(ch)
        i += 1

    tail = "".join(buf).strip()
    if tail:
        statements.append(tail)
    return statements


def ensure_track_table(conn):
    with conn.cursor() as cur:
        cur.execute(
            f"""CREATE TABLE IF NOT EXISTS {TRACK_TABLE} (
                filename   VARCHAR(255) NOT NULL PRIMARY KEY,
                checksum   CHAR(64) NOT NULL,
                statements INT NOT NULL DEFAULT 0,
                applied_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='SQL迁移执行记录'"""
        )
    conn.commit()


def get_applied(conn):
    try:
        with conn.cursor() as cur:
            cur.execute(f"SELECT filename, checksum FROM {TRACK_TABLE}")
            return {row[0]: row[1] for row in cur.fetchall()}
    except pymysql.err.ProgrammingError:
        return {}


def record_applied(conn, filename, checksum, count):
    with conn.cursor() as cur:
        cur.execute(
            f"INSERT INTO {TRACK_TABLE} (filename, checksum, statements) VALUES (%s, %s, %s) "
            f"ON DUPLICATE KEY UPDATE checksum=VALUES(checksum), statements=VALUES(statements), applied_at=CURRENT_TIMESTAMP",
            (filename, checksum, count),
        )
    conn.commit()


def run_file(conn, path: Path, dry_run: bool, strict: bool):
    sql = path.read_text(encoding="utf-8-sig")
    checksum = hashlib.sha256(sql.encode("utf-8")).hexdigest()
    statements = split_statements(sql)
    log(f"\n▶ {path.name}  ({len(statements)} 条语句)")

    if dry_run:
        for idx, stmt in enumerate(statements, 1):
            preview = " ".join(stmt.split())
            if len(preview) > 100:
                preview = preview[:100] + "…"
            log(f"   [{idx}] {preview}")
        return "dry", 0, 0

    ok = warn = fail = 0
    with conn.cursor() as cur:
        for idx, stmt in enumerate(statements, 1):
            try:
                cur.execute(stmt)
                ok += 1
            except pymysql.err.MySQLError as e:
                code = e.args[0] if e.args and isinstance(e.args[0], int) else None
                msg = " ".join(str(a) for a in e.args[1:]) if len(e.args) > 1 else str(e)
                if code in TOLERATED_ERRORS:
                    warn += 1
                    log(f"   ⚠ [{idx}] 已存在，跳过 (errno={code}): {msg[:120]}")
                else:
                    fail += 1
                    log(f"   ✗ [{idx}] 失败 (errno={code}): {msg[:200]}")
                    log(f"        SQL: {' '.join(stmt.split())[:160]}")
                    if strict:
                        conn.rollback()
                        return "strict-abort", ok, fail
    conn.commit()
    if fail == 0:
        record_applied(conn, path.name, checksum, len(statements))
    return ("ok" if warn == 0 else "ok-warn"), ok, fail


def main():
    parser = argparse.ArgumentParser(description="执行后端 db 目录下所有 .sql 到远程数据库")
    parser.add_argument("--dry-run", action="store_true", help="只解析并打印语句，不执行")
    parser.add_argument("--force", action="store_true", help="忽略已执行记录，全部重跑")
    parser.add_argument("--strict", action="store_true", help="遇到非幂等报错立即中止")
    parser.add_argument("--list", action="store_true", help="只列出将要执行的文件")
    parser.add_argument("--only", action="append", default=[], help="只执行指定文件名（可重复）")
    parser.add_argument("--host"); parser.add_argument("--port", type=int)
    parser.add_argument("--database"); parser.add_argument("--user"); parser.add_argument("--password")
    args = parser.parse_args()

    if not DB_DIR.is_dir():
        log(f"ERROR: 找不到 db 目录: {DB_DIR}")
        sys.exit(1)

    # 连接信息：命令行优先，否则解析 application-dev.yml
    try:
        cfg = parse_datasource(CONFIG_FILE)
    except Exception as e:
        log(f"WARN: 解析配置失败（{e}），需要手动传入 --host/--user/--password/--database")
        cfg = {"host": None, "port": 3306, "database": None, "user": None, "password": None}
    for key in ("host", "port", "database", "user", "password"):
        override = getattr(args, key)
        if override is not None:
            cfg[key] = override
    if not all([cfg["host"], cfg["database"], cfg["user"]]):
        log("ERROR: 缺少数据库连接参数")
        sys.exit(1)

    log("=" * 60)
    log(f"db 目录 : {DB_DIR}")
    log(f"目标库  : {cfg['user']}@{cfg['host']}:{cfg['port']}/{cfg['database']}")
    log("=" * 60)

    sql_files = sorted(DB_DIR.glob("*.sql"))
    if args.only:
        wanted = {os.path.basename(f) for f in args.only}
        sql_files = [f for f in sql_files if f.name in wanted]

    conn = pymysql.connect(
        host=cfg["host"], port=int(cfg["port"]), user=cfg["user"],
        password=cfg["password"], database=cfg["database"],
        charset="utf8mb4", connect_timeout=15, autocommit=False,
    )
    log("✓ 数据库连接成功")

    if not args.dry_run:
        ensure_track_table(conn)
    applied = get_applied(conn)

    if args.list:
        for f in sql_files:
            state = "已执行" if (f.name in applied and not args.force) else "待执行"
            log(f"  [{state}] {f.name}")
        conn.close()
        return

    stats = {"ok": 0, "warn": 0, "skip": 0, "fail": 0}
    for f in sql_files:
        checksum = hashlib.sha256(f.read_text(encoding="utf-8-sig").encode("utf-8")).hexdigest()
        if not args.force and not args.dry_run and applied.get(f.name) == checksum:
            log(f"\n⏭  {f.name}  已执行且未改动，跳过（--force 可强制重跑）")
            stats["skip"] += 1
            continue
        status, ok, fail = run_file(conn, f, dry_run=args.dry_run, strict=args.strict)
        if status == "dry":
            continue
        if status in ("ok", "ok-warn"):
            stats["warn" if status == "ok-warn" else "ok"] += 1
        elif status == "strict-abort":
            stats["fail"] += 1
            log(f"\n✗ 因 --strict 中止于 {f.name}")
            break
        else:
            stats["fail"] += 1

    conn.close()
    log("\n" + "=" * 60)
    log(f"完成：成功 {stats['ok']}，含跳过已存在 {stats['warn']}，未改动跳过 {stats['skip']}，失败 {stats['fail']}")
    sys.exit(1 if stats["fail"] else 0)


if __name__ == "__main__":
    main()
